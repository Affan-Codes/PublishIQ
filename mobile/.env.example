# PublishIQ Mobile Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Target build/runtime environment: development | staging | production
APP_ENV=development

# Application package/bundle identifier
APP_IDENTIFIER=com.publishiq.mobile.dev

# Base URL for the PublishIQ backend API (/api/v1 required)
# Local iOS Simulator / Web: http://localhost:4000/api/v1
# Android Emulator: http://10.0.2.2:4000/api/v1
# Physical Device over Wi-Fi: http://<YOUR_LOCAL_IP>:4000/api/v1
API_BASE_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# EAS Project ID (optional, required only for remote EAS Cloud builds)
# EAS_PROJECT_ID=
